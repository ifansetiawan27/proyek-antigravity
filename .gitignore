# Konfigurasi Supabase:
# config.js SENGAJA di-commit — isinya hanya publishable/anon key yang memang
# tampil di browser, dan WAJIB ikut ter-deploy agar data tersimpan ke Supabase.
# (Jangan pernah menaruh service_role key di sana.)
# sales-monitoring/js/config.js
sales-monitoring/.env
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
